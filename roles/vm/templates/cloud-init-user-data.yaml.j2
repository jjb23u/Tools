#cloud-config
hostname: {{ vm_name }}
fqdn: {{ vm_name }}
users:
  - name: {{ vm_user }}
    groups: [wheel]
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    shell: /bin/bash
    ssh_authorized_keys:
      - {{ lookup('ansible.builtin.file', vm_ssh_pubkey_file) }}
ssh_pwauth: false
packages:
  - python3-libdnf5
