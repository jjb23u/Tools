# Copy to secrets.env and fill in. secrets.env is gitignored.
# Loaded verbatim into the containers (no shell/compose interpolation),
# so the bcrypt hash below can contain $ without escaping.

# Backend VNC (internal only; the frontend is your real auth layer)
VNC_GEOMETRY=1600x900
VNC_PASSWORD=change-me

# Frontend browser login
FRONTEND_USER=operator
# Generate the hash with the built frontend image:
#   docker run --rm toolkit-frontend caddy hash-password
# then paste the full $2a$... string here.
FRONTEND_PASSWORD_HASH=
